{
  "name": "cleaner-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images:optimize": "node scripts/optimize-images.mjs",
    "icons:generate": "node scripts/generate-favicons-and-og.mjs",
    "kingdom:art": "node scripts/prepare-kingdom-art.mjs",
    "dev": "next dev --turbopack",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pages:build": "npm run build",
    "pages:preview": "npm run build && opennextjs-cloudflare preview",
    "pages:deploy": "npm run build && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cleaner-planner-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cleaner-planner-db --remote",
    "db:studio": "npx drizzle-kit studio",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "serialize-javascript": "^7.0.4",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pixi/react": "^8.0.5",
    "@react-spring/web": "^10.0.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.525.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^7.30.0",
    "pixi.js": "^8.14.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-intersection-observer": "^10.0.3",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24"
  }
}
